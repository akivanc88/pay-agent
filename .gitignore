# Environment — never commit. A live Stripe key in a public repo is a real incident.
.env
.env.*
!.env.example

# Secrets / keys
*.pem
*.key

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Local databases (SQLite).
# The -wal and -shm files are WAL-mode sidecars — the store opens connections with
# journal_mode=WAL, so these appear next to every database file.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# WSL/Windows metadata streams created when files are copied in from Windows
*:Zone.Identifier

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
