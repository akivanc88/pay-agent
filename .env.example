# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# No spaces around "=" — a leading space becomes part of the value in most
# dotenv parsers and surfaces later as a confusing authentication failure.

# ---------------------------------------------------------------------------
# Stripe — TEST MODE. Everything in M1–M3 uses these.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---------------------------------------------------------------------------
# Stripe — LIVE MODE. Leave unset until the M4 real-card decline demo.
#
# This is a deliberately separate variable, never a swapped value of the test
# key, so live mode cannot be entered by accident. Two guards depend on it:
#
#   1. The live path refuses to run unless the intended charge EXCEEDS the
#      enrolled balance — so the only live outcome is a decline, and no money
#      moves.
#   2. The deployed build FAILS AT STARTUP if this is present. The hosted demo
#      is test-mode only; a public URL and live card rails must never meet.
#
# Only ever set this on the local laptop, never in a deployment environment.
# ---------------------------------------------------------------------------
# STRIPE_LIVE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Gift-card code pepper.
#
# A pepper is not stored beside the data, so a database leak alone does not
# permit offline enumeration of card codes. Required in production; a clearly
# labelled development fallback is used when unset outside production.
#
# Generate one with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
# GIFT_CARD_CODE_PEPPER=
