    "demo:both": "tsx --env-file-if-exists=../../.env scripts/demo.ts both"
  },
  "dependencies": {
    "stripe": "^22.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
