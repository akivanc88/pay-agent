# Copy to .env (or set in the monorepo root .env) and fill in with a real Shopify Partner app's
# credentials — create one at https://partners.shopify.com. Nothing in this repo can create that
# account or app registration for you.

# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders
# SHOPIFY_APP_URL=https://your-deployed-app.example.com

# Optional: link this app to a running pay-agent Cloud instance so the embedded admin page can
# show real usage/fee data for a shop once it's associated with a tenant (see that repo's README —
# the shop<->tenant linking flow itself isn't wired up yet).
# PAY_AGENT_CLOUD_URL=

PORT=3020
SHOP_DB_PATH=.data/shops.db
