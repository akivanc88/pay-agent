# Copy to .env (or set in the monorepo root .env) and fill in with a real Shopify Partner app's
# credentials — create one at https://partners.shopify.com. Nothing in this repo can create that
# account or app registration for you.

# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders
# SHOPIFY_APP_URL=https://your-deployed-app.example.com

# Optional: link this app to a running pay-agent Cloud instance so a newly-installed shop is
# auto-provisioned a Cloud tenant, and the embedded admin page can show its real usage/fee data.
# CLOUD_ADMIN_TOKEN must match that Cloud instance's ADMIN_TOKEN. Leave both unset to run without
# Cloud linking (install still works; the admin page just won't show usage).
# PAY_AGENT_CLOUD_URL=
# CLOUD_ADMIN_TOKEN=

PORT=3020
SHOP_DB_PATH=.data/shops.db
